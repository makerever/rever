FROM node:24-alpine
RUN apk add --no-cache libc6-compat

# Enable Corepack + pnpm before copying code
RUN corepack enable \
    && corepack prepare pnpm@latest --activate

# Working directory
WORKDIR /app

# Copy monorepo
COPY . .

# Install dependencies for monorepo
RUN pnpm install --frozen-lockfile

# Add node_modules bin to PATH for dev commands
ENV PATH=/app/node_modules/.bin:/app/web/node_modules/.bin:$PATH

# Use turbo via pnpm dlx, not global
CMD ["pnpm", "dlx", "turbo", "dev", "--filter=web"]
