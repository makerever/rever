{
  "compilerOptions": {
    "baseUrl": "src",
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "jsx": "react-jsx",
    "paths": {
      "@rever/common": ["."],
      "@rever/common/*": ["*"],
      "@rever/i18n": ["../i18n/src"],
      "@rever/i18n/*": ["../i18n/src/*"]
    }
  },
  "include": ["src"]
}
