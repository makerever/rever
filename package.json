{
  "name": "rever",
  "description": "Invioce and payment management system",
  "private": true,
  "repository": "https://github.com/makerever/rever.git",
  "version": "0.8.0",
  "license": "AGPL-3.0",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
