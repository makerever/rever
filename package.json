    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\""
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "turbo": "^2.5.3"
  },
  "packageManager": "pnpm@10.22.0",
  "resolutions": {
    "form-data": "4.0.4",
    "tmp": "^0.2.4",
    "@eslint/plugin-kit": "^0.3.4"
  }
}